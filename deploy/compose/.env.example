POSTGRES_PASSWORD=changez-moi-superutilisateur
LATTIS_SERVICE_PASSWORD=changez-moi-service
LATTIS_REPLICATION_PASSWORD=changez-moi-replication
LATTIS_BOOTSTRAP_OWNER=vous@example.com
LATTIS_PUBLIC_URL=http://localhost:8080

# Réplica en lecture (docker compose --profile replicas up) : décommenter.
# LATTIS_PG_RO_URLS=postgres://lattis_service:${LATTIS_SERVICE_PASSWORD}@replica:5432/lattis?sslmode=require&connect_timeout=3
# LATTIS_PG_PUBLIC_RO=localhost:5433

# Édition web, moteurs en conteneurs (docker compose --profile docker-engines up) :
# décommenter, avec LATTIS_IMAGE=be-lattis/lattisd:web et LATTIS_EDITION=web.
# LATTIS_WEB_LAUNCHER=docker
# LATTIS_WEB_LAUNCHER_URL=http://launcher:8090
# LATTIS_WEB_LAUNCHER_TOKEN_FILE=/etc/lattis/launcher/token
# LATTIS_WEB_TOKEN_URL=http://lattisd:8081/engine/token
# LATTIS_ENGINE_IMAGE=ghcr.io/be-lattis/lattis-engine:main
